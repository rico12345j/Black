{
  "name": "github-clone",
  "version": "2.0.0",
  "description": "🐙 GitHub Clone — منصة تطوير برمجيات متكاملة",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "jest",
    "lint": "eslint backend/**/*.js frontend/**/*.js",
    "format": "prettier --write backend/**/*.js frontend/**/*.js",
    "seed": "node backend/scripts/seed.js",
    "migrate": "node backend/scripts/migrate.js",
    "build": "npm run build:frontend",
    "build:frontend": "echo 'Building frontend...'",
    "deploy": "npm run build && npm start",
    "backup": "node backend/scripts/migrate.js backup",
    "restore": "node backend/scripts/migrate.js restore"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^6.10.0",
    "express-session": "^1.17.3",
    "connect-mongo": "^5.0.0",
    "mongoose": "^7.0.0",
    "passport": "^0.6.0",
    "passport-local": "^1.0.0",
    "passport-jwt": "^4.0.1",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "validator": "^13.9.0",
    "dotenv": "^16.0.3",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.1",
    "socket.io": "^4.5.4",
    "socket.io-client": "^4.5.4",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.0",
    "uuid": "^9.0.0",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "eslint": "^8.38.0",
    "eslint-plugin-react": "^7.32.2",
    "prettier": "^2.8.7",
    "@faker-js/faker": "^8.0.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "github",
    "clone",
    "git",
    "version-control",
    "collaboration",
    "development"
  ],
  "author": "The Architect",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/github-clone.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/github-clone/issues"
  },
  "homepage": "https://github.com/your-username/github-clone#readme"
}